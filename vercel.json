{
  "rewrites": [
    { "source": "/", "destination": "/prototype/index.html" },
    { "source": "/index.html", "destination": "/prototype/index.html" }
  ],
  "headers": [
    {
      "source": "/prototype/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    },
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
